rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts allowed into the private webtoon studio (/convert-video-to-webtoon).
    function isStudio() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['frank.houbre@gmail.com'];
    }

    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Working drafts of the webtoon strips: studio only.
    // A long strip is sliced into a `chunks` subcollection (see lib/webtoon/studio.ts).
    match /webtoon_drafts/{slug} {
      allow read, write: if isStudio();
      match /chunks/{chunk} {
        allow read, write: if isStudio();
      }
    }

    // The studio's library of characters and locations: studio only.
    match /webtoon_library/{slug} {
      allow read, write: if isStudio();
    }

    // Named save points of a strip (lib/webtoon/snapshots-client.ts), sliced like the drafts: studio only.
    match /webtoon_snapshots/{key} {
      allow read, write: if isStudio();
      match /chunks/{chunk} {
        allow read, write: if isStudio();
      }
    }

    // Background jobs of the studio (lib/webtoon/studio-job.ts): studio only.
    // The account's refresh token is kept there encrypted with a server secret.
    match /webtoon_jobs/{slug} {
      allow read, write: if isStudio();
    }

    // Running cost of the generations of a strip: studio only.
    match /webtoon_costs/{slug} {
      allow read, write: if isStudio();
    }

    // Anonymous reading statistics (lib/webtoon/reads.ts): one document per
    // reading session, nothing personal. Anyone creates and moves forward a
    // session with exactly these fields; only the studio reads or deletes.
    function isReadSession(slug, sessionId) {
      let d = request.resource.data;
      return sessionId.size() <= 80
        && d.keys().hasOnly(['slug', 'locale', 'max_index', 'total', 'panel_id', 'device', 'started_at', 'updated_at'])
        && d.keys().hasAll(['slug', 'locale', 'max_index', 'total', 'panel_id', 'device', 'started_at', 'updated_at'])
        && d.slug is string && d.slug == slug && d.slug.size() <= 80
        && d.locale is string && d.locale.size() <= 80
        && d.panel_id is string && d.panel_id.size() <= 80
        && d.max_index is int && d.max_index >= 0 && d.max_index <= 5000
        && d.total is int && d.total >= 1 && d.total <= 5000
        && d.device in ['mobile', 'desktop']
        && d.started_at is timestamp
        && d.updated_at == request.time;
    }

    match /webtoon_reads/{slug} {
      allow read, delete: if isStudio();
      match /sessions/{sessionId} {
        allow read, delete: if isStudio();
        allow create: if isReadSession(slug, sessionId)
          && request.resource.data.started_at == request.time;
        allow update: if isReadSession(slug, sessionId)
          && request.resource.data.max_index >= resource.data.max_index
          && request.resource.data.slug == resource.data.slug
          && request.resource.data.started_at == resource.data.started_at;
      }
    }

    // Episode alerts (lib/webtoon/alerts.ts), double opt-in. The document id
    // is an HMAC of the address that only the server can compute, and it
    // travels only in the links of the emails: whoever holds it may read,
    // confirm or delete that one document. Nobody lists the collection but the
    // studio. A new document is always pending, with exactly these fields.
    function isSubscriber(id) {
      let d = request.resource.data;
      return id.matches('^[A-Za-z0-9_-]{43}$')
        && d.keys().hasOnly(['email', 'locale', 'status', 'created_at', 'updated_at'])
        && d.keys().hasAll(['email', 'locale', 'status', 'created_at', 'updated_at'])
        && d.email is string && d.email.size() >= 6 && d.email.size() <= 254
        && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.locale in ['en', 'fr', 'ja', 'ko']
        && d.status in ['pending', 'confirmed']
        && d.created_at is timestamp
        && d.updated_at == request.time;
    }

    match /webtoon_subscribers/{id} {
      allow get: if true;
      allow list: if isStudio();
      allow delete: if true;
      allow create: if isSubscriber(id)
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time;
      // pending -> pending (a new link) or confirmed; confirmed stays confirmed.
      allow update: if isSubscriber(id)
        && request.resource.data.email == resource.data.email
        && request.resource.data.created_at == resource.data.created_at
        && (request.resource.data.status == 'confirmed' || resource.data.status == 'pending');
    }

    // When each episode was announced to the subscribers, and to how many: studio only.
    match /webtoon_announcements/{slug} {
      allow read, write: if isStudio();
    }

    // The version the public reader shows: anyone reads, the studio writes.
    match /webtoon_published/{slug} {
      allow read: if true;
      allow write: if isStudio();
      match /chunks/{chunk} {
        allow read: if true;
        allow write: if isStudio();
      }
    }
  }
}
