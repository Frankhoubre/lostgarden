rules_version = '2';

// Panel images regenerated or uploaded from the webtoon studio.
service firebase.storage {
  match /b/{bucket}/o {
    match /webtoon/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['frank.houbre@gmail.com']
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
